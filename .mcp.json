{
  "mcpServers": {
    "edgepilot-research-0-13-0": {
      "type": "stdio",
      "command": "node",
      "args": [
        "./.mcp-launcher.mjs",
        "./src/edgepilot_research/local_mcp.py"
      ],
      "cwd": ".",
      "enabled": true,
      "env_vars": [
        "PATH",
        "APPDATA"
      ],
      "startup_timeout_sec": 10,
      "tool_timeout_sec": 30
    }
  }
}
